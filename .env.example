# ===================================================================
# RestaurantHub — Production & Local Environment Variable Reference
# ===================================================================
#
# NOTE: This file is a TEMPLATE with placeholders.
# DO NOT commit real credentials or secrets to version control.
# In local development, you can use 'backend/src/main/resources/application-local.properties' (gitignored).
# In production, pass these environment variables to the container / runtime environment.
# ===================================================================

# Spring Active Profile ('dev' for local, 'prod' for production HTTPS)
SPRING_PROFILES_ACTIVE=prod

# Server Port
PORT=8080

# Production MySQL Database Configuration (Required in 'prod' profile)
# Example: jdbc:mysql://<db-host>:3306/<db-name>?useSSL=true&requireSSL=true&allowPublicKeyRetrieval=false&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/restaurant_hub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# Cross-Origin Resource Sharing (CORS)
# Leave blank or omit if Angular and Spring Boot API are served behind the same reverse proxy / domain.
# For separated deployment, provide comma-separated origin URLs (e.g., https://restaurant.example.com,https://admin.example.com)
CORS_ALLOWED_ORIGINS=

# Media Storage Provider ('local' for persistent filesystem disk, 'cloudinary' for cloud CDN)
MEDIA_PROVIDER=local

# Local Media Root Directory (Must be a persistent, backed-up filesystem path in production)
# Example Linux: /var/data/restaurant-hub/uploads
# Example Windows: C:/data/restaurant-hub/uploads
MEDIA_LOCAL_ROOT=uploads

# Session Timeout (Default: 30m)
SESSION_TIMEOUT=30m

# Optional Cloudinary Storage (Only needed if MEDIA_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
